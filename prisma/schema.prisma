generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  plan         Plan     @default(FREE)
  proExpiresAt DateTime?
  createdAt    DateTime @default(now())
  leads        Lead[]
  otps         Otp[]
  passwordResets PasswordResetToken[]
  messageTemplates MessageTemplate[]
  templatesSeededAt DateTime?
  emailConnections EmailConnection[]
  agentSettings    AgentSettings?
  agentLogs        AgentLog[]
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  urlToLeadUsage         Int       @default(0)
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Otp {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Lead {
  id              String   @id @default(cuid())
  companyName     String
  niche           String
  instagramHandle String
  website         String   @default("")
  email           String   @default("")
  brandScore      Int      @default(5)
  contentScore    Int      @default(5)
  revenueScore    Int      @default(5)
  status          String    @default("new")
  notes           String    @default("")
  lastContactedAt DateTime?
  unsubscribed    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  emailLogs       EmailLog[]
  emailSequence   EmailSequence?
}

model EmailLog {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId            String
  subject           String
  body              String
  direction         String    @default("outbound")
  status            String    @default("sent")
  providerMessageId String?
  sequenceStep      Int?
  sentAt            DateTime  @default(now())
  receivedAt        DateTime?

  @@index([leadId, sentAt])
  @@index([userId])
  @@index([providerMessageId])
}

model EmailSequence {
  id           String    @id @default(cuid())
  leadId       String    @unique
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId   String?
  template     SequenceTemplate? @relation(fields: [templateId], references: [id])
  currentStep  Int       @default(0)
  nextSendAt   DateTime?
  startedAt    DateTime  @default(now())
  pausedAt     DateTime?
  completedAt  DateTime?
  step1SentAt  DateTime?
  step2DueAt   DateTime?
  step2SentAt  DateTime?
  step3DueAt   DateTime?
  step3SentAt  DateTime?

  @@index([step2DueAt])
  @@index([step3DueAt])
  @@index([nextSendAt])
}

model SequenceTemplate {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  steps       SequenceTemplateStep[]
  sequences   EmailSequence[]

  @@index([userId])
}

model EmailConnection {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  email          String
  status         String   @default("active")
  lastError      String?
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scope          String?
  smtpHost       String?
  smtpPort       Int?
  smtpSecure     Boolean?
  smtpUser       String?
  smtpPassEnc    String?
  imapHost       String?
  imapPort       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

model MessageTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  body        String
  type        String   @default("outreach")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model AgentSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled            Boolean  @default(false)
  autoGenerateMsg    Boolean  @default(true)
  autoSendFirst      Boolean  @default(false)
  autoEnrollSequence Boolean  @default(true)
  highOppOnly        Boolean  @default(false)
  maxDailySends      Int      @default(20)
  stopOnReply        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AgentLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId    String?
  action    String
  detail    String   @default("")
  status    String   @default("success")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([leadId])
}

model SequenceTemplateStep {
  id              String           @id @default(cuid())
  templateId      String
  template        SequenceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stepNumber      Int
  subjectTemplate String
  bodyTemplate    String
  delayDays       Int
  createdAt       DateTime         @default(now())

  @@unique([templateId, stepNumber])
}
